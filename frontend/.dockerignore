# Exclude dependencies and build output from build context
node_modules/
dist/
dist-ssr/
build/

# Exclude environment secrets & local configs
.env
.env.*

# Exclude Git & IDE metadata
.git/
.gitignore
.vscode/
.idea/
*.swp
*.swo

# Exclude Logs & Debug files
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Exclude Docker & Documentation
Dockerfile
.dockerignore
README.md
